# The ChestMNIST arrays are 79 MB and are redistributed by MedMNIST, so they are
# fetched rather than committed. See README.md, section "Getting the data".
data/*.npy
data/*.npz

# MLflow store. The run history is reproducible from the scripts; committing a
# SQLite database would also make every branch merge a binary conflict.
mlflow.db
mlflow.db-journal
mlartifacts/
mlruns/

# Score vectors persisted for the figures (regenerated by the two run scripts).
results/scores/
results/artifacts/

# LaTeX build products
paper/*.aux
paper/*.log
paper/*.out
paper/*.bbl
paper/*.blg
paper/*.toc
paper/*.synctex.gz
paper/*.fdb_latexmk
paper/*.fls

__pycache__/
*.py[cod]
.ipynb_checkpoints/
.venv/
venv/
.DS_Store
Thumbs.db
